QWEN_API_KEY=your-api-key-here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_OUTLINE_MODEL=qwen3.6-plus
# Phase 1.5 relevel model — text-only LLM, no vision needed, defaults to qwen3.7-max
# QWEN_RELEVEL_MODEL=qwen3.7-max
# Phase 1.5 relevel max output tokens — larger docs need more room for the JSON array
# QWEN_RELEVEL_MAX_TOKENS=32768
# Phase 1.5 relevel timeout in seconds — large docs can take 5-7 min to generate
# QWEN_RELEVEL_TIMEOUT=600
# Set to false to skip Phase 1.5 LLM heading re-leveling
ENABLE_RELEVEL=true
# Phase 2.5 cross-page table-split repair (text-only LLM, defaults to qwen3.7-max)
# QWEN_PHASE25_MODEL=qwen3.7-max
# QWEN_PHASE25_MAX_TOKENS=8192
# QWEN_PHASE25_TIMEOUT=300
# Set to false to skip Phase 2.5 table-split repair
ENABLE_PHASE25=true
QWEN_ENABLE_THINKING=false
# Lower temperature/top_p for more stable extraction (same page re-run varies less)
QWEN_TEMPERATURE=0
QWEN_TOP_P=0.1
QWEN_MAX_TOKENS=8192
# Optional fixed seed when the model supports it; leave empty to omit
# QWEN_SEED=42
PDF_RENDER_DPI=600
MAX_PREVIOUS_TAIL_CHARS=300
PYMUPDF_TEXT_MIN_CHARS=50
PYMUPDF_STRUCTURE_CONFIDENCE_MIN=0.45
PHASE2_MAX_WORKERS=16
REPAIR_TAIL_CONTINUATIONS=false
